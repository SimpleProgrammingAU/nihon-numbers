{
  "name": "nihon-numbers",
  "version": "1.0.13",
  "description": "A lightweight module to convert numbers from Arabic to Japanese characters.",
  "main": "./lib/index.js",
  "type": "commonjs",
  "types": "./lib/index.d.ts",
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "lib/index.d.ts"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "tsc",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit && tsc6 --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run build",
    "test": "c8 mocha",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "prepack": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "c8": "12.0.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "mocha": "12.0.3",
    "prettier": "3.9.9",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.1"
  },
  "keywords": [
    "numbers",
    "japanese",
    "converter"
  ],
  "author": "Simple Programming <hi@simpleprogramming.com.au> (https://www.simpleprogramming.com.au/)",
  "homepage": "https://github.com/SimpleProgrammingAU/nihon-numbers#readme",
  "bugs": {
    "url": "https://github.com/SimpleProgrammingAU/nihon-numbers/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimpleProgrammingAU/nihon-numbers.git"
  }
}
